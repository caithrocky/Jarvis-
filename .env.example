# JARVIS AI – Third-Party API & Backend Configuration
# Configure actual secrets via the Secrets panel in AI Studio.
# Never commit a populated .env file to version control.

# NVIDIA NIM API Key (https://build.nvidia.com)
NVIDIA_NIM_API_KEY=MY_NVIDIA_NIM_API_KEY

# Supabase Backend (https://supabase.com)
SUPABASE_URL=MY_SUPABASE_URL
SUPABASE_ANON_KEY=MY_SUPABASE_ANON_KEY

# Deriv Broker Integration (https://app.deriv.com / https://developers.deriv.com)
DERIV_APP_ID=MY_DERIV_APP_ID
DERIV_API_TOKEN=MY_DERIV_API_TOKEN

# Binance Spot Trading API (https://www.binance.com - Read & Spot Trade only, NO Withdrawal)
BINANCE_API_KEY=MY_BINANCE_API_KEY
BINANCE_API_SECRET=MY_BINANCE_API_SECRET

# Finnhub Market News & Economic Calendar (https://finnhub.io)
FINNHUB_API_KEY=MY_FINNHUB_API_KEY

# MetaTrader 4/5 Bridge (Optional self-hosted REST bridge / MetaApi)
MT_BRIDGE_URL=MY_MT_BRIDGE_URL
MT_BRIDGE_TOKEN=MY_MT_BRIDGE_TOKEN
